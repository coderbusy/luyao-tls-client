<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<!-- Enable AOT compatibility analysis for .NET 8+ -->
		<IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
		<!-- Enable trimming compatibility analysis -->
		<IsTrimmable Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net7.0' or '$(TargetFramework)' == 'net6.0'">true</IsTrimmable>
		<!-- NuGet Package Metadata -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://www.coderbusy.com/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/coderbusy/luyao-tls-client</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net45' or '$(TargetFramework)'=='net461'">
		<Reference Include="System.Net.Http" />
	</ItemGroup>
	
	<ItemGroup>
		<Compile Include="..\..\build\Consts.cs" Link="Consts.cs" />
	</ItemGroup>

	<!-- Newtonsoft.Json only for older frameworks that don't have System.Text.Json -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net45' or '$(TargetFramework)' == 'net461' or '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="runtimes\**" Pack="true" PackagePath="runtimes\" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	
	<!-- Include README.md in the NuGet package -->
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
