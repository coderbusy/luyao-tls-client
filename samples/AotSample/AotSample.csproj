<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enable Native AOT compilation -->
    <PublishAot>true</PublishAot>
    
    <!-- Enable trimming for smaller output -->
    <PublishTrimmed>true</PublishTrimmed>
    
    <!-- Optional: Optimize for size -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    
    <!-- Optional: Enable invariant globalization for smaller output -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the local LuYao.TlsClient project -->
    <ProjectReference Include="..\..\src\LuYao.TlsClient\LuYao.TlsClient.csproj" />
  </ItemGroup>

</Project>
